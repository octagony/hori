{
  "name": "hori-frontend",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./dist/style.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./dist/style.css --watch",
    "copy:assets": "cp src/index.html dist/ && cp node_modules/htmx.org/dist/htmx.min.js dist/",
    "build": "npm run build:css && npm run copy:assets",
    "dev": "npm run copy:assets && npm run watch:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "daisyui": "^5.7.50",
    "htmx.org": "^4.0.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5"
  }
}